#!/usr/bin/env bash

set -e

provider=$1
legacy_key=$2
legacy_secret=$3
filepath=$4
bucket=$5
destination=$6
max_concurrent_requests=$7
max_bandwidth=$8
storage_class=$9
content_disposition=${10}
region=${11}
endpoint_url=${12}
credential_file=""

cleanup() {
  if [[ -n "${credential_file}" ]]; then
    rm -f "${credential_file}"
  fi
}

trap cleanup EXIT

case "${provider}" in
"aws")
  if [[ -n "${legacy_key}" ]]; then
    export AWS_ACCESS_KEY_ID="${legacy_key}"
  fi
  if [[ -n "${legacy_secret}" ]]; then
    export AWS_SECRET_ACCESS_KEY="${legacy_secret}"
  fi
  if [[ -n "${region}" ]]; then
    export AWS_REGION="${region}"
  fi
  if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
    >&2 echo "Missing AWS secret access key"
    exit 1
  fi
  storage_class=${storage_class:-STANDARD}
  upload_aws \
    "${filepath}" "${bucket}" "${destination}" "${max_concurrent_requests}" "${max_bandwidth}" "${storage_class}" "${content_disposition}" "${endpoint_url}"
  ;;
"azure")
  if [[ -n "${legacy_key}" ]]; then
    export AZURE_STORAGE_ACCOUNT="${legacy_key}"
  fi
  if [[ -n "${legacy_secret}" ]]; then
    export AZURE_STORAGE_KEY="${legacy_secret}"
  fi
  endpoint_url=${endpoint_url:-${AZURE_STORAGE_ENDPOINT:-}}
  if [[ -z "${AZURE_STORAGE_ACCOUNT}" || -z "${AZURE_STORAGE_KEY}" ]]; then
    >&2 echo "Missing Azure storage account key"
    exit 1
  fi
  upload_azure \
    "${filepath}" "${bucket}" "${destination}" \
    "${max_concurrent_requests}" "${max_bandwidth}" "${storage_class}" "${content_disposition}" "${endpoint_url}"
  ;;
"gcp")
  gcp_credentials=${legacy_key:-${GOOGLE_APPLICATION_CREDENTIALS:-${GCP_SA:-}}}
  if [[ -z "${gcp_credentials}" ]]; then
    >&2 echo "Missing GCP service account credentials"
    exit 1
  fi
  if [[ ! -f "${gcp_credentials}" ]]; then
    credential_file=$(mktemp /tmp/gcp-sa.XXXXXX)
    chmod 600 "${credential_file}"
    printf '%s' "${gcp_credentials}" | base64 -d > "${credential_file}"
    gcp_credentials=${credential_file}
  fi
  upload_gcp "${gcp_credentials}" "${filepath}" "${bucket}" "${destination}" "${storage_class}" "${content_disposition}"
  ;;
*)
  if [[ -n "${legacy_key}" ]]; then
    export AWS_ACCESS_KEY_ID="${legacy_key}"
  fi
  if [[ -n "${legacy_secret}" ]]; then
    export AWS_SECRET_ACCESS_KEY="${legacy_secret}"
  fi
  if [[ -n "${region}" ]]; then
    export AWS_REGION="${region}"
  fi
  if [[ -z "${AWS_ACCESS_KEY_ID:-}" || -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
    >&2 echo "Missing S3 secret access key"
    exit 1
  fi
  if [[ -z "${endpoint_url}" ]]; then
    >&2 echo "Missing S3 endpoint URL"
    exit 1
  fi
  upload_aws \
    "${filepath}" "${bucket}" "${destination}" "${max_concurrent_requests}" "${max_bandwidth}" "${storage_class}" "${content_disposition}" "${endpoint_url}"
  ;;
esac
