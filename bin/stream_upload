#!/usr/bin/env bash

set -Eeo pipefail

provider=$1
key=$2
secret=$3
stream_path=$4
status_path=$5
bucket=$6
destination=$7
# Positional argument 8 is retained for compatibility with backup images and
# callers that still pass the former temporary destination.
max_concurrent_requests=$9
max_bandwidth=${10}
storage_class=${11}
content_disposition=${12}
region=${13}
endpoint_url=${14}

flags=(--config /dev/null)
relay_dir=""
relay_path=""
relay_writer_open=0
upload_pid=""

cleanup() {
  exit_code=$?
  trap - EXIT INT TERM

  # Terminate the uploader before closing its input. Closing first could make
  # an interrupted upload look complete to the object store.
  if [[ -n "${upload_pid}" ]]; then
    kill "${upload_pid}" >/dev/null 2>&1 || true
    wait "${upload_pid}" >/dev/null 2>&1 || true
  fi
  if [[ "${relay_writer_open}" == "1" ]]; then
    exec 10>&-
  fi
  if [[ -n "${relay_path}" ]]; then
    rm -f "${relay_path}"
  fi
  if [[ -n "${relay_dir}" ]]; then
    rmdir "${relay_dir}" >/dev/null 2>&1 || true
  fi

  exit "${exit_code}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -n "${max_bandwidth}" ]]; then
  flags+=(--bwlimit "${max_bandwidth}M")
fi
if [[ -n "${content_disposition}" ]]; then
  flags+=(--header-upload "Content-Disposition: ${content_disposition}")
fi

case "${provider}" in
"aws")
  if [[ -z "${secret}" ]]; then
    echo >&2 "Missing AWS secret access key"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE=s3
  export RCLONE_CONFIG_STREAM_PROVIDER=AWS
  export RCLONE_CONFIG_STREAM_ACCESS_KEY_ID="${key}"
  export RCLONE_CONFIG_STREAM_SECRET_ACCESS_KEY="${secret}"
  export RCLONE_CONFIG_STREAM_REGION="${region}"
  export RCLONE_CONFIG_STREAM_ENDPOINT="${endpoint_url}"
  if [[ -n "${max_concurrent_requests}" ]]; then
    flags+=(--s3-upload-concurrency "${max_concurrent_requests}")
  fi
  if [[ -n "${storage_class}" ]]; then
    flags+=(--s3-storage-class "${storage_class}")
  fi
  ;;
"digitalocean")
  if [[ -z "${secret}" ]]; then
    echo >&2 "Missing S3 secret access key"
    exit 1
  fi
  if [[ -z "${endpoint_url}" ]]; then
    echo >&2 "Missing S3 endpoint URL"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE=s3
  export RCLONE_CONFIG_STREAM_PROVIDER=DigitalOcean
  export RCLONE_CONFIG_STREAM_ACCESS_KEY_ID="${key}"
  export RCLONE_CONFIG_STREAM_SECRET_ACCESS_KEY="${secret}"
  export RCLONE_CONFIG_STREAM_REGION="${region}"
  export RCLONE_CONFIG_STREAM_ENDPOINT="${endpoint_url}"
  if [[ -n "${max_concurrent_requests}" ]]; then
    flags+=(--s3-upload-concurrency "${max_concurrent_requests}")
  fi
  ;;
"cloudflare")
  if [[ -z "${secret}" ]]; then
    echo >&2 "Missing R2 secret access key"
    exit 1
  fi
  if [[ -z "${endpoint_url}" ]]; then
    echo >&2 "Missing R2 endpoint URL"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE=s3
  export RCLONE_CONFIG_STREAM_PROVIDER=Cloudflare
  export RCLONE_CONFIG_STREAM_ACCESS_KEY_ID="${key}"
  export RCLONE_CONFIG_STREAM_SECRET_ACCESS_KEY="${secret}"
  export RCLONE_CONFIG_STREAM_REGION="${region}"
  export RCLONE_CONFIG_STREAM_ENDPOINT="${endpoint_url}"
  if [[ -n "${max_concurrent_requests}" ]]; then
    flags+=(--s3-upload-concurrency "${max_concurrent_requests}")
  fi
  if [[ -n "${storage_class}" ]]; then
    flags+=(--s3-storage-class "${storage_class}")
  fi
  ;;
"backblaze")
  if [[ -z "${secret}" ]]; then
    echo >&2 "Missing B2 application key"
    exit 1
  fi
  if [[ -z "${endpoint_url}" ]]; then
    echo >&2 "Missing B2 S3 endpoint URL"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE=s3
  export RCLONE_CONFIG_STREAM_PROVIDER=Other
  export RCLONE_CONFIG_STREAM_ACCESS_KEY_ID="${key}"
  export RCLONE_CONFIG_STREAM_SECRET_ACCESS_KEY="${secret}"
  export RCLONE_CONFIG_STREAM_REGION="${region}"
  export RCLONE_CONFIG_STREAM_ENDPOINT="${endpoint_url}"
  if [[ -n "${max_concurrent_requests}" ]]; then
    flags+=(--s3-upload-concurrency "${max_concurrent_requests}")
  fi
  ;;
"gcp")
  if [[ ! -f "${key}" ]]; then
    echo >&2 "Google service account file does not exist"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE="google cloud storage"
  export RCLONE_CONFIG_STREAM_SERVICE_ACCOUNT_FILE="${key}"
  if [[ -n "${storage_class}" ]]; then
    flags+=(--gcs-storage-class "${storage_class}")
  fi
  ;;
"azure")
  if [[ -z "${secret}" ]]; then
    echo >&2 "Missing Azure storage account key"
    exit 1
  fi
  export RCLONE_CONFIG_STREAM_TYPE=azureblob
  export RCLONE_CONFIG_STREAM_ACCOUNT="${key}"
  export RCLONE_CONFIG_STREAM_KEY="${secret}"
  if [[ -n "${endpoint_url}" ]]; then
    flags+=(--azureblob-endpoint "${endpoint_url}")
  fi
  if [[ -n "${max_concurrent_requests}" ]]; then
    flags+=(--azureblob-upload-concurrency "${max_concurrent_requests}")
  fi
  if [[ -n "${storage_class}" ]]; then
    access_tier=$(printf '%s' "${storage_class}" | tr '[:upper:]' '[:lower:]')
    flags+=(--azureblob-access-tier "${access_tier}")
  fi
  ;;
*)
  echo >&2 "Unsupported stream upload provider ${provider}"
  exit 1
  ;;
esac

# Backup destinations are selected and validated before this uploader starts.
# Never let rclone turn a failed bucket check into an attempt to create a
# customer-owned bucket, which also keeps least-privilege object credentials
# usable without s3:ListBucket or s3:CreateBucket.
if [[ "${RCLONE_CONFIG_STREAM_TYPE}" == "s3" ]]; then
  export RCLONE_CONFIG_STREAM_NO_CHECK_BUCKET=true

  # The destination contains the unique backup ID and cannot already exist.
  # Avoid a pre-upload existence check. Rclone still verifies unknown-length
  # streams with HeadObject after upload, which uses the read permission also
  # required for restoring the resulting backup.
  flags+=(--no-check-dest)
fi

destination_remote="stream:${bucket}/${destination}"

# Relay the producer FIFO through a second FIFO. Keeping the relay writer open
# prevents rclone from completing the destination object until the producer's
# terminal status has been checked. A failed producer instead terminates
# rclone, which aborts an in-progress multipart or resumable upload.
relay_dir=$(mktemp -d "${stream_path}.upload.XXXXXX")
relay_path="${relay_dir}/data"
mkfifo "${relay_path}"
rclone rcat "${destination_remote}" "${flags[@]}" < "${relay_path}" &
upload_pid=$!
exec 10> "${relay_path}"
relay_writer_open=1

if ! cat "${stream_path}" >&10; then
  echo >&2 "Backup stream relay failed"
  exit 1
fi

# The producer writes its status as it exits; allow for the short interval
# between its stream reaching EOF and the atomic status rename.
for _ in $(seq 1 60); do
  if [[ -s "${status_path}" ]]; then
    break
  fi
  sleep 1
done

if [[ ! -s "${status_path}" ]]; then
  echo >&2 "Backup producer did not report its status"
  exit 1
fi

producer_status=$(tr -d '[:space:]' < "${status_path}")
if [[ "${producer_status}" != "0" ]]; then
  echo >&2 "Backup producer failed with exit code ${producer_status}"
  exit 1
fi

# Only a successful producer is allowed to deliver EOF to rclone and publish
# the final object.
exec 10>&-
relay_writer_open=0
if wait "${upload_pid}"; then
  upload_pid=""
else
  upload_status=$?
  upload_pid=""
  echo >&2 "Backup upload failed with exit code ${upload_status}"
  exit "${upload_status}"
fi
